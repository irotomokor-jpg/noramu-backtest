+/* v3.7 typography: language-aware UI font + stable clock numerals */
+:root{
+  --font-ko:"Pretendard Variable","Pretendard","Apple SD Gothic Neo","Noto Sans KR","Malgun Gothic",system-ui,-apple-system,"Segoe UI",sans-serif;
+  --font-ja:"Pretendard Variable","Noto Sans JP","Hiragino Sans","Hiragino Kaku Gothic ProN","Yu Gothic","Meiryo",system-ui,sans-serif;
+  --font-en:"Pretendard Variable","Inter","SF Pro Text","Segoe UI",Roboto,Arial,sans-serif;
+  --font-num:"Pretendard Variable","SF Pro Display","Segoe UI",Roboto,Arial,sans-serif;
+  --font-ui:var(--font-ko);
+}
+html[lang="ko"]{--font-ui:var(--font-ko)}
+html[lang="ja"]{--font-ui:var(--font-ja)}
+html[lang="en"]{--font-ui:var(--font-en)}
+button,input,select,textarea{font-family:var(--font-ui);font-synthesis:none}
+h1,.result strong.big,.route-title,.timeline-card .title{letter-spacing:-.025em}
+header p,.muted,.timeline-card .subtitle,.timeline-card .detail{letter-spacing:-.012em}
+
+/* Times should look identical when KO/JA/EN is switched. */
+.target-time,.timeline-timebox .clock,.timeline-time,.journey-time,
+.service-window .times,.live-line,.bus-candidate .hist{
+  font-family:var(--font-num);
+  font-variant-numeric:tabular-nums lining-nums;
+  font-feature-settings:"tnum" 1,"lnum" 1;
+  font-kerning:normal;
+}
+.target-time{
+  min-height:62px;
+  line-height:1;
+  color:#111827;
+  -webkit-text-fill-color:#111827;
+}
+input[type="time"]::-webkit-datetime-edit,
+input[type="time"]::-webkit-datetime-edit-fields-wrapper,
+input[type="time"]::-webkit-datetime-edit-text,
+input[type="time"]::-webkit-datetime-edit-hour-field,
+input[type="time"]::-webkit-datetime-edit-minute-field,
+input[type="time"]::-webkit-datetime-edit-ampm-field{
+  font-family:var(--font-num);
+  font-variant-numeric:tabular-nums lining-nums;
+  font-feature-settings:"tnum" 1,"lnum" 1;
+  letter-spacing:0;
+  font-weight:800;
+  color:#111827;
+}
+input[type="time"]::-webkit-calendar-picker-indicator{opacity:.72}
+html[lang="ja"] .eyebrow{letter-spacing:.09em}
+html[lang="ja"] h1,html[lang="ja"] .result strong.big{letter-spacing:-.015em}
+html[lang="en"] h1{letter-spacing:-.03em}
