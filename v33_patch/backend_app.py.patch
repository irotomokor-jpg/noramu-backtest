+def _rail_service_type(row: dict) -> str | None:
+    """Best-effort train class extraction from timetable providers.
+
+    The KR rail XLSX stores this explicitly in rail_events.service_type. TAGO
+    deployments expose different field names, so inspect known aliases without
+    inventing a class when the provider omits it.
+    """
+    aliases = (
+        'serviceType', 'trainType', 'trainTypeNm', 'subwayTrainType',
+        'subwayTrainTypeNm', 'runType', 'runTypeNm', 'expressType',
+        'expressTypeNm', 'trainKind', 'trainKindNm',
+    )
+    for k in aliases:
+        v = str(row.get(k) or '').strip()
+        if v:
+            return v
+    for k in ('expressYn', 'expYn'):
+        v = str(row.get(k) or '').strip().upper()
+        if v in ('Y','1','TRUE'):
+            return '급행'
+        if v in ('N','0','FALSE'):
+            return '일반'
+    return None
+
+
