+def live_bus_arrival(route_id: str, station_id: str, sta_order: int | str | None):
+    """Official Gyeonggi BMS arrival snapshot for one route at one stop."""
+    if not route_id or not station_id or sta_order in (None, '', 0, '0'):
+        return None
+    data = request_json(
+        f'{BUS_ARRIVAL_BASE}/getBusArrivalItemv2',
+        {'format': 'json', 'stationId': station_id, 'routeId': route_id, 'staOrder': sta_order},
+    )
+    item = find_recursive(data, 'busArrivalItem')
+    if isinstance(item, list):
+        item = item[0] if item else None
+    if not isinstance(item, dict):
+        return None
+
+    vehicles = []
+    for n in (1, 2):
+        eta_min = _int_or_none(item.get(f'predictTime{n}'))
+        eta_sec = _int_or_none(item.get(f'predictTimeSec{n}'))
+        if eta_sec is None and eta_min is not None:
+            eta_sec = eta_min * 60
+        if eta_min is None and eta_sec is not None:
+            eta_min = max(0, round(eta_sec / 60))
+        if eta_min is None and eta_sec is None:
+            continue
+        seats = _int_or_none(item.get(f'remainSeatCnt{n}'))
+        vehicles.append({
+            'order': n,
+            'etaMin': eta_min,
+            'etaSec': eta_sec,
+            'stopsAway': _int_or_none(item.get(f'locationNo{n}')),
+            'plateNo': str(item.get(f'plateNo{n}') or ''),
+            'vehicleId': str(item.get(f'vehId{n}') or ''),
+            'currentStation': str(item.get(f'stationNm{n}') or ''),
+            'remainSeats': seats if seats is not None and seats >= 0 else None,
+            'lowPlateCode': _int_or_none(item.get(f'lowPlate{n}')),
+        })
+    return {
+        'routeId': str(item.get('routeId') or route_id),
+        'routeName': str(item.get('routeName') or ''),
+        'stationId': str(item.get('stationId') or station_id),
+        'staOrder': _int_or_none(item.get('staOrder')) or _int_or_none(sta_order),
+        'routeDestination': str(item.get('routeDestName') or ''),
+        'flag': str(item.get('flag') or ''),
+        'queryTime': str(find_recursive(data, 'queryTime') or ''),
+        'vehicles': vehicles,
+    }
+
+
+def attach_live_bus_arrivals(candidates: list[dict], deadline_sec: int | None = None, max_calls: int = 6):
+    """Attach realtime arrivals without letting a current bus distort a far-future arrive-by plan."""
+    now = datetime.now(ZoneInfo('Asia/Seoul'))
+    now_sec = now.hour * 3600 + now.minute * 60 + now.second
+    calls = 0
+    cache = {}
+    for c in candidates:
+        rid = str(c.get('routeId') or '').strip()
+        sid = str(c.get('originStationId') or (c.get('accessStop') or {}).get('id') or '').strip()
+        seq = c.get('originSeq') or c.get('staOrder')
+        key = (rid, sid, str(seq or ''))
+        if not rid or not sid or not seq:
+            continue
+        if key not in cache:
+            if calls >= max_calls:
+                continue
+            try:
+                cache[key] = live_bus_arrival(rid, sid, seq)
+            except Exception as exc:
+                cache[key] = {'error': str(exc), 'vehicles': []}
+            calls += 1
+        live = cache.get(key)
+        c['liveArrival'] = live
+        if not live or live.get('error') or not live.get('vehicles'):
+            continue
+
+        planned = _int_or_none(c.get('recommendedBoardingSec') or c.get('latestBoardingSec'))
+        if planned is not None:
+            planned_abs = planned
+            while planned_abs < now_sec - 3600:
+                planned_abs += 86400
+            c['liveRelevant'] = -600 <= (planned_abs - now_sec) <= 7200
+        else:
+            c['liveRelevant'] = True
+
+        first = live['vehicles'][0]
+        eta_sec = _int_or_none(first.get('etaSec'))
+        travel_min = float(c.get('travelMedianMin') or c.get('busMinutesEstimate') or 0)
+        if eta_sec is not None and deadline_sec is not None and c.get('liveRelevant'):
+            deadline_abs = int(deadline_sec)
+            while deadline_abs < now_sec - 3600:
+                deadline_abs += 86400
+            transfer_arrival_abs = now_sec + eta_sec + int(travel_min * 60)
+            c['liveCanCatchRail'] = transfer_arrival_abs <= deadline_abs
+            c['liveEstimatedTransferArrival'] = db_sec_to_hm(transfer_arrival_abs, True)
+    return {'checkedAt': now.strftime('%H:%M:%S'), 'calls': calls, 'candidates': candidates}
+
