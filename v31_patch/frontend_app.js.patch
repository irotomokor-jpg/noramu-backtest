+function liveBusHtml(b){
+  const live=b.liveArrival;
+  if(!live || live.error) return '';
+  const vs=live.vehicles||[];
+  if(!vs.length) return `<div class="live-line muted">실시간 ${live.flag||'조회됨'} · 현재 도착예정 차량 없음</div>`;
+  const fmt=v=>{
+    const eta=v.etaMin!=null?`${v.etaMin}분 후`:'도착시간 확인 중';
+    const stops=v.stopsAway!=null?` · ${v.stopsAway}정거장 전`:'';
+    const seat=v.remainSeats!=null?` · ${v.remainSeats}석`:'';
+    return `${eta}${stops}${seat}`;
+  };
+  const catchText=b.liveRelevant
+    ? (b.liveCanCatchRail===true?`<b class="live-ok">이 차량으로 목표 열차 연결 가능</b>`:b.liveCanCatchRail===false?`<b class="live-warn">이 차량은 목표 열차 연결이 빠듯/불가</b>`:'')
+    : `<span class="muted">계획 탑승시각과 멀어 현재 실시간은 참고용</span>`;
+  return `<div class="live-line"><b>실시간</b> ${vs.map(fmt).join(' / ')}${live.routeDestination?` · ${live.routeDestination} 방면`:''}<br>${catchText}</div>`;
+}
+
+function subwaySegments(subway){
+  const stations=subway?.stations||[];
+  const lines=subway?.lines||[];
+  if(stations.length<2 || !lines.length) return [];
+  const out=[];
+  let start=0, line=lines[0];
+  for(let i=1;i<lines.length;i++){
+    if(lines[i]!==line){
+      out.push({line,from:stations[start],to:stations[i],stops:i-start});
+      start=i; line=lines[i];
+    }
+  }
+  out.push({line,from:stations[start],to:stations[stations.length-1],stops:stations.length-1-start});
+  return out;
+}
+
+function genericTimeline(c){
+  const rows=[];
+  const push=(kind,time,title,sub,detail)=>rows.push(timelineRow(kind,time,title,sub,detail));
+  if(c.accessStop){
+    push('walk','-',`현재 위치 → ${c.accessStop.name}`,`도보 약 ${c.accessWalkMinutes||'-'}분`,`${Math.round(c.accessDistanceM||0)}m`);
+  }
+
+  const subwayRows=()=>{
+    const segs=subwaySegments(c.subway);
+    if(!segs.length && c.subway){
+      push('suin','-',`${state.origin.type==='subway'?state.origin.name:(c.transferSubwayStation||'지하철')}역 출발`,`${c.subway.to||state.destination.name}역까지 지하철`, `구조 예상 약 ${c.subway.minutesEstimate||'-'}분`);
+      return;
+    }
+    segs.forEach(seg=>{
+      const line=String(seg.line||'');
+      const kind=line.includes('신분당')?'shin':'suin';
+      push(kind,'-',`${badge(line.includes('신분당')?'신분당선':'수인분당선')}${seg.from}역 → ${seg.to}역`,`${line}선 · ${seg.stops}개 역`, `시간표 DB 미적재 구간은 구조 예상`);
+    });
+  };
+
+  const busRow=()=>{
+    const from=c.originName||c.transferBusStationName||c.accessStop?.name||state.origin.name;
+    const to=c.destinationBusStationName||c.transferBusStationName||c.egressStop?.name||state.destination.name;
+    const mins=c.busMinutesEstimate||c.totalMinutesEstimate||'-';
+    push('bus','-',`${badge('버스')}${c.routeName?c.routeName+'번':'버스'} 탑승`,`${from} → ${to}`,`버스 구조 예상 약 ${mins}분${c.busStops!=null?` · ${c.busStops}정거장`:''}`);
+  };
+
+  const mode=String(c.mode||'');
+  const subwayFirst=state.origin.type==='subway' || mode.includes('subway-to');
+  if(subwayFirst){ if(c.subway) subwayRows(); if(c.routeName) busRow(); }
+  else { if(c.routeName) busRow(); if(c.subway) subwayRows(); }
+
+  if(c.egressStop){
+    push('walk','-',`${c.egressStop.name} → 현재 위치`,`하차 후 도보 약 ${c.egressWalkMinutes||'-'}분`,`${Math.round(c.egressDistanceM||0)}m`);
+  }
+  push('finish','-',`${state.destination.name} 도착`,`출발지: ${state.origin.name}`,`전체 구조 예상 약 ${c.totalMinutesEstimate||'-'}분`);
+  return `<div class="timeline-v2">${rows.join('')}</div>`;
+}
