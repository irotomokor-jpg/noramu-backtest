+def seoul_subway_realtime(station_name: str):
+    """Optional Seoul TOPIS realtime arrival. Empty when no separate Seoul key is configured."""
+    key = os.getenv('SEOUL_SUBWAY_REALTIME_KEY', '').strip()
+    if not key:
+        return {'enabled': False, 'items': [], 'reason': 'SEOUL_SUBWAY_REALTIME_KEY not configured'}
+    try:
+        url = f"{SEOUL_SUBWAY_REALTIME_BASE}/{key}/json/realtimeStationArrival/0/20/{station_name}"
+        r = requests.get(url, timeout=8)
+        r.raise_for_status()
+        data = r.json()
+        rows = data.get('realtimeArrivalList') or []
+        items=[]
+        for x in rows:
+            items.append({
+                'stationName': str(x.get('statnNm') or station_name),
+                'line': str(x.get('trainLineNm') or x.get('subwayId') or ''),
+                'direction': str(x.get('updnLine') or ''),
+                'etaSec': _int_or_none(x.get('barvlDt')),
+                'message': str(x.get('arvlMsg2') or ''),
+                'serviceType': '급행' if str(x.get('btrainSttus') or '') == '급행' else None,
+                'receivedAt': str(x.get('recptnDt') or ''),
+            })
+        return {'enabled': True, 'items': items}
+    except Exception as exc:
+        return {'enabled': True, 'items': [], 'error': str(exc)}
+
