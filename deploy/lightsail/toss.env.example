# Copy values from Toss WTS > Settings > Open API.
# Keep this file root-readable only (0600). Never commit real values.
TOSS_CLIENT_ID=REPLACE_ME
TOSS_CLIENT_SECRET=REPLACE_ME

# Polling / data collection
POLL_SECONDS=60
SHADOW_DATA_DIR=/var/lib/noramu-shadow

# Doro v0.16 + leveraged ETF v0.03 read-only watchlist
US_WATCHLIST=NVDA,AAPL,MSFT,AMZN,GOOGL,AVGO,META,TSLA,MU,NFLX,COST,PLTR,AMD,CSCO,TMUS,INTU,AMAT,QCOM,ISRG,JPM,LLY,WMT,V,MA,XOM,JNJ,ORCL,TQQQ,QQQ,SOXL,SOXX

# Initial KR smoke/watchlist. Noramu dynamic universe will be wired as a separate producer.
KR_WATCHLIST=005930,035420
