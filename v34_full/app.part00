// Official KR rail foreign-name datasets are the source of truth. The app keeps
// Korean provider names internally and changes only the display name. Unknown
// stations intentionally fall back to Korean instead of fabricating a translation.
const OFFICIAL_STATION_NAMES={
  "고색":{ko:"고색",en:"Gosaek",ja:"コセク"},
  "수원":{ko:"수원",en:"Suwon",ja:"スウォン"},
  "정자":{ko:"정자",en:"Jeongja",ja:"チョンジャ"},
  "판교":{ko:"판교(판교테크노밸리)",en:"Pangyo (Pangyo Techno Valley)",ja:"パンギョ（パンギョテクノバレー）"},
  "강남":{ko:"강남",en:"Gangnam",ja:"カンナム"},
  "양재":{ko:"양재",en:"Yangjae",ja:"ヤンジェ"},
  "미금":{ko:"미금",en:"Migeum",ja:"ミグム"}
};
function stationKey(name){return String(name||"").replace(/\([^)]*\)/g,"").replace(/역$/,'').replace(/\s+/g,'').trim();}
function displayStationName(name,type="subway"){
  if(type!=="subway") return String(name||"");
  const key=stationKey(name),row=OFFICIAL_STATION_NAMES[key];
  return row?.[state?.lang]||row?.ko||String(name||"");
}
function displayPlace(item){return item?.type==="subway"?displayStationName(item.name,"subway"):String(item?.name||"");}
function tr(key,vars={}){let s=(I18N[state?.lang]||I18N.ko)[key]??I18N.ko[key]??key;return String(s).replace(/\{(\w+)\}/g,(_,k)=>vars[k]??"");}
