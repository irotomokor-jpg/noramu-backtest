    tc.hidden=true;
    $("#planBtn").textContent=tr("planFirst");
    $("#resultKicker").textContent=tr("resultFirst");
    $("#nowBtn").hidden=true;
  }else{
    tc.hidden=true;
    $("#planBtn").textContent=tr("planLast");
    $("#resultKicker").textContent=tr("resultLast");
    $("#nowBtn").hidden=true;
  }
}
document.querySelectorAll(".mode-tab").forEach(x=>x.onclick=()=>setMode(x.dataset.mode));
$("#nowBtn").onclick=()=>{
  const d=new Date();$("#target").value=`${String(d.getHours()).padStart(2,"0")}:${String(d.getMinutes()).padStart(2,"0")}`;
};

function showLoading(){
  $("#resultCard").hidden=false;$("#result").innerHTML=`<strong class="big">${tr("loading")}</strong>`;
  requestAnimationFrame(()=>$("#resultCard").scrollIntoView({behavior:"smooth",block:"start"}));
}

function leg(label,big,small){
  return `<div class="rail-leg"><span>${label}</span><b>${big}</b><span>${small||""}</span></div>`;
}

function badge(line){
  if(line==="신분당선")return `<span class="line-badge shin">${tr("shin")}</span>`;
  if(line==="수인분당선")return `<span class="line-badge suin">${tr("suin")}</span>`;
  if(line==="버스")return `<span class="line-badge bus">${tr("bus")}</span>`;
  return `<span class="line-badge transfer">${line}</span>`;
}

function timelineRow(kind, timeText, titleHtml, subtitleHtml="", detailHtml="", isLast=false){
  return `
    <div class="timeline-row ${kind}">
      <div class="timeline-timebox">
        <div class="clock">${timeText || "-"}</div>
        <div class="mini">${kind==="walk"?tr("walk"):kind==="bus"?tr("bus"):kind==="suin"?tr("rail1"):kind==="shin"?tr("rail2"):tr("arrival")}</div>
      </div>
      <div class="timeline-track">
        <div class="shaft"></div>
        <div class="node"></div>
      </div>
      <div class="timeline-card">
        <div class="title">${titleHtml}</div>
        ${subtitleHtml ? `<div class="subtitle">${subtitleHtml}</div>` : ""}
        ${detailHtml ? `<div class="detail">${detailHtml}</div>` : ""}
      </div>
    </div>`;
}


function liveBusHtml(b){
  const live=b.liveArrival;
  if(!live || live.error) return '';
  const vs=live.vehicles||[];
  if(!vs.length) return `<div class="live-line muted">${tr('live')} ${live.flag||''} · ${tr('noVehicle')}</div>`;
  const fmt=v=>{
    const eta=v.etaMin!=null?tr('minutesLater',{n:v.etaMin}):tr('checking');
    const stops=v.stopsAway!=null?` · ${tr('stopsAway',{n:v.stopsAway})}`:'';
    const seat=v.remainSeats!=null?` · ${tr('seats',{n:v.remainSeats})}`:'';
    return `${eta}${stops}${seat}`;
  };
  const catchText=b.liveRelevant
    ? (b.liveCanCatchRail===true?`<b class="live-ok">${tr('canCatch')}</b>`:b.liveCanCatchRail===false?`<b class="live-warn">${tr('cannotCatch')}</b>`:'')
    : `<span class="muted">${tr('farRealtime')}</span>`;
  return `<div class="live-line"><b>${tr('live')}</b> ${vs.map(fmt).join(' / ')}${live.routeDestination?` · ${tr('direction',{name:live.routeDestination})}`:''}<br>${catchText}</div>`;
}

function subwaySegments(subway){
  const stations=subway?.stations||[];
  const lines=subway?.lines||[];
  if(stations.length<2 || !lines.length) return [];
  const out=[];
  let start=0, line=lines[0];
  for(let i=1;i<lines.length;i++){
    if(lines[i]!==line){
      out.push({line,from:stations[start],to:stations[i],stops:i-start});
      start=i; line=lines[i];
    }
  }
  out.push({line,from:stations[start],to:stations[stations.length-1],stops:stations.length-1-start});
  return out;
}

function genericTimeline(c){
  const rows=[];
  const push=(kind,time,title,sub,detail)=>rows.push(timelineRow(kind,time,title,sub,detail));
  if(c.accessStop){
    push('walk','-',tr('currentToStop',{name:c.accessStop.name}),tr('minutes',{n:c.accessWalkMinutes||'-'}),`${Math.round(c.accessDistanceM||0)}m`);
  }

  const subwayRows=()=>{
    const segs=subwaySegments(c.subway);
    if(!segs.length && c.subway){
      const from=state.origin.type==='subway'?state.origin.name:(c.transferSubwayStation||tr('subway'));
      push('suin','-',`${from} → ${c.subway.to||state.destination.name}`,tr('subwayTo',{to:c.subway.to||state.destination.name}),tr('minutes',{n:c.subway.minutesEstimate||'-'}));
      return;
    }
    segs.forEach(seg=>{
      const line=String(seg.line||'');
      const kind=line.includes('신분당')?'shin':'suin';
      push(kind,'-',`${badge(line.includes('신분당')?'신분당선':'수인분당선')}${tr('subwayRide',{from:seg.from,to:seg.to})}`,tr('stations',{n:seg.stops}),tr('timetablePending'));
    });
  };

  const busRow=()=>{
    const from=c.originName||c.accessStop?.name||state.origin.name;
    const to=c.transferBusStationName||c.destinationBusStationName||c.egressStop?.name||state.destination.name;
    const mins=c.busMinutesEstimate||c.totalMinutesEstimate||'-';
    push('bus','-',`${badge('버스')}${c.routeName?tr('busRide',{route:c.routeName}):tr('bus')}`,tr('walkFromTo',{from,to}),`${tr('busEstimate',{n:mins})}${c.busStops!=null?` · ${tr('busStops',{n:c.busStops})}`:''}`);
  };

  const mode=String(c.mode||'');
  const subwayFirst=state.origin.type==='subway' || mode.includes('subway-to');
  if(subwayFirst){ if(c.subway) subwayRows(); if(c.routeName) busRow(); }
  else { if(c.routeName) busRow(); if(c.subway) subwayRows(); }

  if(c.egressStop){
    push('walk','-',tr('walkFromTo',{from:c.egressStop.name,to:tr('currentLocation')}),tr('afterAlightWalk',{n:c.egressWalkMinutes||'-'}),`${Math.round(c.egressDistanceM||0)}m`);
  }
  push('finish','-',tr('arrived',{name:state.destination.name}),tr('fromOrigin',{name:state.origin.name}),tr('wholeEstimate',{n:c.totalMinutesEstimate||'-'}));
  return `<div class="timeline-v2">${rows.join('')}</div>`;
}

function busCandidateHtml(b,i){
  const board=b.recommendedBoarding||b.latestBoarding||b.originMedian||"-";
  const dest=b.estimatedGosaek||b.estimatedDestination||"-";
