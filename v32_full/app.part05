    ${busWindows || '<div class="warning-note">버스 운행창을 찾지 못했습니다.</div>'}
    <div class="warning-note">${x.busNote}</div>
    <div class="status-note">철도 데이터: ${x.railSource}<br>시간표 매칭: ${x.railPairing}</div>`;
}

function renderForward(x){
  const rows=(x.busPatterns||[]).map(b=>{
    if(!b.samples)return `<div class="bus-candidate"><div class="route">${b.routeName}번</div><div class="hist">과거 기록 없음</div></div>`;
    return `<div class="bus-candidate"><div class="route">${b.routeName}번</div><div class="hist">이 시간대 중앙 ${b.median} · 80%범위 ${b.p10}~${b.p90} · ${b.samples}일</div></div>`;
  }).join("");
  $("#result").innerHTML=`<strong class="big">${x.depart} 출발 기준</strong>${rows}<div class="status-note">${x.message}</div>`;
}

async function genericRoute(){
  const q=new URLSearchParams({
    origin_type:state.origin.type,origin_id:state.origin.id,origin_name:state.origin.name,
    destination_type:state.destination.type,destination_id:state.destination.id,destination_name:state.destination.name,
    mode:state.mode
  });
  return api(`/api/router/free?${q}`);
}

$("#planBtn").onclick=async()=>{
  if(!state.origin||!state.destination)return alert(tr("selectBoth"));
  showLoading();
  const t=$("#target").value||"08:25";
  try{
    const isPangyo = state.destination.type==="subway" && state.destination.name.includes("판교");
    const selectedWow = state.origin.type==="bus" && (state.origin.name.includes("와우지구") || String(state.origin.mobileNo||"")==="36194" || String(state.origin.id||"")==="233000945");
    const tryGpsPangyo = isPangyo && state.origin.type==="coordinate" && state.mode==="reverse";
    const tryWowPangyo = isPangyo && selectedWow && state.mode==="reverse";

    if(tryGpsPangyo || tryWowPangyo){
      const extra=state.origin.type==="coordinate"
        ? `&origin_lat=${encodeURIComponent(state.origin.lat)}&origin_lon=${encodeURIComponent(state.origin.lon)}`
        : `&origin_station_id=${encodeURIComponent(state.origin.id||"")}`;
      const reverse=await api(`/api/planner/reverse-pangyo?target=${encodeURIComponent(t)}&pangyo_station_id=${encodeURIComponent(state.destination.id||"")}${extra}`);
      if((reverse.busCandidates||[]).length){
        renderReverse(reverse);
        return;
      }
      // GPS can be anywhere. If no Gosaek-bound candidate exists nearby, use the general router instead of fabricating a benchmark leg.
    }

    if(isPangyo && selectedWow && state.mode==="forward"){
      renderForward(await api(`/api/planner/forward-pangyo?depart=${encodeURIComponent(t)}&origin_station_id=${encodeURIComponent(state.origin.id||"")}`));
      return;
    }
    if(isPangyo && selectedWow && (state.mode==="first" || state.mode==="last")){
      renderFirstLast(await api(`/api/planner/firstlast-pangyo?criterion=${state.mode}&pangyo_station_id=${encodeURIComponent(state.destination.id||"")}&origin_station_id=${encodeURIComponent(state.origin.id||"")}`));
      return;
    }

    const r=await genericRoute();
    if(r.ok && r.candidates && r.candidates.length){
      const c={...r.candidates[0],mode:r.mode};
      $("#result").innerHTML=`<strong class="big">${state.origin.name} → ${state.destination.name}</strong>
      <div class="path-summary">${tr('genericSummary')}</div>
      ${genericTimeline(c)}
      ${liveBusHtml(c)}
      <div class="status-note">${tr('genericNote')}${r.realtimeCheckedAt?` ${tr('live')} ${r.realtimeCheckedAt}.`:''}</div>`;
    }else if(r.ok && r.path){
      $("#result").innerHTML=`<strong class="big">${state.origin.name} → ${state.destination.name}</strong><div class="status-note">${r.path.stations.join(" → ")}</div>`;
    }else{
      $("#result").innerHTML=`<strong class="big">${state.origin.name} → ${state.destination.name}</strong><div class="status-note">${r.message||tr('noRoute')}</div>`;
    }
  }catch(e){$("#result").innerHTML=`<strong class="big">${tr('calcFailed')}</strong><div class="status-note">${e.message}</div>`;}
};

const langSelect=$("#langSelect");
if(langSelect){
  langSelect.value=state.lang;
  langSelect.addEventListener("change",()=>{
    state.lang=langSelect.value;
    localStorage.setItem("transitLang",state.lang);
    applyLanguage();
    if(!$("#resultCard").hidden && state.origin && state.destination){
      $("#result").innerHTML=`<div class="status-note">${tr('langChanged')}</div>`;
    }
  });
}

// No preselected stations. Placeholder examples are visual only.
state.origin=null;
state.destination=null;
$("#originInput").value="";
$("#destinationInput").value="";
syncSelected();
setMode("reverse");
applyLanguage();


async function refreshDataStatus(){
  try{
    const s=await api('/api/status');
    const c=s.counts||{};
    if($('#metadataStatus')) $('#metadataStatus').innerHTML=`노선 <b>${(c.bus_routes||0).toLocaleString()}</b> · 정류장 <b>${(c.bus_stations||0).toLocaleString()}</b> · 노선-정류장 <b>${(c.route_stations||0).toLocaleString()}</b><br>마지막 동기화: ${s.metadataSyncedAt||'아직 안 함'}`;
    const enabled=(s.watchlist||[]).filter(x=>x.enabled).length;
    if($('#watchStatus')) $('#watchStatus').innerHTML=`활성 노선 <b>${enabled}</b> · 오늘 위치 API <b>${s.locationCallsToday}</b>회`;
    if($('#historyStatus')) $('#historyStatus').innerHTML=`통과 이벤트 <b>${(c.bus_arrivals||0).toLocaleString()}</b>건 · raw 관측 <b>${(c.bus_observations||0).toLocaleString()}</b>건`;
  }catch(e){ if($('#metadataStatus')) $('#metadataStatus').textContent='상태 조회 실패: '+e.message; }
}
refreshDataStatus();

// local dev: ensure stale SW/cache cannot take over
(async()=>{try{
  if("serviceWorker" in navigator){for(const r of await navigator.serviceWorker.getRegistrations())await r.unregister();}
  if("caches" in window){for(const k of await caches.keys())await caches.delete(k);}
}catch(e){}})();
