+
+def auto_seed_watchlist():
+    """Seed useful routes at collector startup so collection does not depend on a user search."""
+    added = 0
+    for name in AUTO_SEED_ROUTE_NAMES:
+        try:
+            data = request_json(ROUTE_SEARCH_URL, {'format': 'json', 'keyword': name})
+            rows = ensure_list(find_recursive(data, 'busRouteList'))
+            exact = [r for r in rows if str(r.get('routeName') or '').strip() == name]
+            for r in (exact or rows[:2]):
+                rid = str(r.get('routeId') or '').strip()
+                if not rid:
+                    continue
+                rname = str(r.get('routeName') or name).strip()
+                upsert_watch(rid, rname or None, 88, 'auto-seed-route')
+                try:
+                    hydrate_route(rid, rname)
+                except Exception:
+                    pass
+                added += 1
+        except Exception as exc:
+            print('auto-seed route failed', name, exc)
+
+    for sid in AUTO_SEED_STATION_IDS:
+        try:
+            data = request_json(STATION_ROUTES_URL, {'format': 'json', 'stationId': sid})
+            rows = ensure_list(find_recursive(data, 'busRouteList'))
+            for r in rows[:60]:
+                rid = str(r.get('routeId') or '').strip()
+                if not rid:
+                    continue
+                rname = str(r.get('routeName') or '').strip()
+                upsert_watch(rid, rname or None, 82, 'auto-seed-station')
+                added += 1
+        except Exception as exc:
+            print('auto-seed station failed', sid, exc)
+    print(f'auto-seed watchlist: +{added} registrations / routes={AUTO_SEED_ROUTE_NAMES} / stations={AUTO_SEED_STATION_IDS}')
+    return added
+
