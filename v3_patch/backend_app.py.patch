+def structural_bus_candidates(origin_station_id: str, deadline_sec: int, route_names=None):
+    """Build truthful fallback boarding candidates when historical arrivals are not ready."""
+    route_names = route_names or ['46', '720', '700-2', '1007']
+    router = FreeRouter(lambda u,p: request_json(u,p), find_recursive, ensure_list)
+    allowed = {str(x) for x in route_names}
+    try:
+        serving = router.station_routes(origin_station_id)
+    except Exception:
+        return []
+    out = []
+    for route in serving:
+        rname = str(route.get('routeName') or '').strip()
+        rid = str(route.get('routeId') or '').strip()
+        if not rid or rname not in allowed:
+            continue
+        try:
+            rows = router.route_stations(rid)
+        except Exception:
+            continue
+        origin_seqs = [int(r.get('stationSeq') or r.get('staOrder') or 0) for r in rows if str(r.get('stationId') or '') == str(origin_station_id)]
+        if not origin_seqs:
+            continue
+        for oseq in origin_seqs:
+            transfers = [r for r in rows if int(r.get('stationSeq') or r.get('staOrder') or 0) > oseq and '고색역' in str(r.get('stationName') or '')]
+            if not transfers:
+                continue
+            stop = min(transfers, key=lambda r: int(r.get('stationSeq') or r.get('staOrder') or 0))
+            dseq = int(stop.get('stationSeq') or stop.get('staOrder') or 0)
+            stops = max(1, dseq - oseq)
+            travel = max(4.0, stops * 1.65)
+            latest_board = int(deadline_sec - travel * 60)
+            info = router.route_info(rid)
+            headway = router.headway_profile(info, 'weekday')
+            # Ranking only; this does not pretend to know an exact future bus timetable.
+            reliability = float(headway.get('reliabilityPenalty') or 0)
+            score = travel + reliability + float(headway.get('expectedWaitMin') or 0)
+            out.append({
+                'routeId': rid,
+                'routeName': rname,
+                'historyAvailable': False,
+                'source': 'route-structure',
+                'originStationId': origin_station_id,
+                'transferBusStationId': str(stop.get('stationId') or ''),
+                'transferBusStationName': str(stop.get('stationName') or ''),
+                'busStops': stops,
+                'travelMedianMin': round(travel, 1),
+                'latestBoardingSec': latest_board,
+                'latestBoarding': db_sec_to_hm(latest_board, True),
+                'estimatedDestination': db_sec_to_hm(int(latest_board + travel * 60), True),
+                'headway': headway,
+                'score': round(score, 1),
+                'note': '실제 과거도착 표본이 없어 노선 구조·배차간격으로 계산한 마지막 탑승 가능 시각',
+            })
+    unique = {}
+    for c in out:
+        k = c['routeId']
+        if k not in unique or c['score'] < unique[k]['score']:
+            unique[k] = c
+    return sorted(unique.values(), key=lambda x: (x['score'], -x['latestBoardingSec']))
+
